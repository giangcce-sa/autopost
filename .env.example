# ─── Claude API (sinh nội dung) ───────────────────────────────────────────
# Bắt buộc cho giai đoạn GENERATE. Lấy key tại https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Nguồn dữ liệu ────────────────────────────────────────────────────────
# Hacker News và RSS không cần key. Các nguồn dưới đây cần key khi triển khai.

# Reddit (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trendos/0.1

# X / Twitter API v2 (trả phí)
TWITTER_BEARER_TOKEN=

# YouTube Data API v3
YOUTUBE_API_KEY=

# GitHub (tuỳ chọn — tăng rate limit)
GITHUB_TOKEN=

# ─── Cấu hình runtime (tuỳ chọn — đã có mặc định trong config.py) ──────────
# TRENDOS_DATABASE_URL=sqlite:///trendos.db
# TRENDOS_CLAUDE_MODEL=claude-opus-4-8
# TRENDOS_TOP_N_TRENDS=10
# TRENDOS_MIN_TREND_SCORE=0.3
