# ─── Claude API (sinh nội dung) ───────────────────────────────────────────
# Bắt buộc cho giai đoạn GENERATE. Lấy key tại https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Nguồn dữ liệu ────────────────────────────────────────────────────────
# Hacker News và RSS không cần key. Các nguồn dưới đây cần key khi triển khai.

# Reddit (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trendos/0.1

# X / Twitter API v2 (trả phí)
TWITTER_BEARER_TOKEN=
TWITTER_QUERY=(AI OR startup OR technology OR programming) lang:en -is:retweet

# YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=US

# Google Trends pytrends geo/pn (vd. united_states, vietnam)
GOOGLE_TRENDS_GEO=united_states

# GitHub (tuỳ chọn — tăng rate limit)
GITHUB_TOKEN=

# ─── Provider media/đăng bài/analytics ───────────────────────────────────
# Dùng "local" để chạy end-to-end an toàn, không gọi dịch vụ ngoài.
# Production có thể dùng import path: package.module:factory_or_provider_class
IMAGE_PROVIDER_KEY=
VIDEO_PROVIDER_KEY=
PUBLISH_PROVIDER_KEY=
FACEBOOK_TOKEN=
TIKTOK_TOKEN=
TIKTOK_PROVIDER_KEY=
ANALYTICS_PROVIDER_KEY=
OUTPUT_DIR=trendos_output

# ─── Cấu hình runtime (tuỳ chọn — đã có mặc định trong config.py) ──────────
# TRENDOS_DATABASE_URL=sqlite:///trendos.db
# API_KEY=change-me-for-production
# TRENDOS_CLAUDE_MODEL=claude-opus-4-8
# TRENDOS_TOP_N_TRENDS=10
# TRENDOS_MIN_TREND_SCORE=0.3
# SCHEDULER_INTERVAL_SECONDS=3600
